# Copy to .env and fill in. Never commit .env.
# LLM provider: anthropic (default, Claude) or nim (NVIDIA NIM, free tier for prototyping)
PT_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# NIM only: key from build.nvidia.com; model must support tool calling
NVIDIA_API_KEY=
PT_NIM_MODEL=meta/llama-3.3-70b-instruct
# Optional overrides
# PT_MODEL / PT_JUDGE_MODEL default per provider; PT_JUDGE_PROVIDER defaults to PT_PROVIDER
PT_MODEL=
PT_JUDGE_MODEL=
PT_EFFORT=high
PT_MAX_TOOL_CALLS=40
ALLOWED_ORIGINS=http://localhost:3000
EVAL_ADMIN_TOKEN=
# MotherDuck (optional). With both set, the API queries MotherDuck instead of the local file.
# Upload with a read/write token; give the API a read-only (read scaling) token.
MOTHERDUCK_TOKEN=
PT_MD_DATABASE=
