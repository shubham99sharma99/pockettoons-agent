# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=
# Optional overrides
PT_MODEL=claude-opus-5-5
PT_JUDGE_MODEL=claude-opus-5-5
PT_EFFORT=high
PT_MAX_TOOL_CALLS=40
ALLOWED_ORIGINS=http://localhost:3000
EVAL_ADMIN_TOKEN=
# MotherDuck (optional). With both set, the API queries MotherDuck instead of the local file.
# Upload with a read/write token; give the API a read-only (read scaling) token.
MOTHERDUCK_TOKEN=
PT_MD_DATABASE=
